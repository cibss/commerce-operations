{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "COMMERCE_API_ORIGIN",
        "COMMERCE_PLATFORM_URL",
        "COMMERCE_QUOTATIONS_ORIGIN",
        "COMMERCE_ORDERS_ORIGIN",
        "COMMERCE_CUSTOMERS_ORIGIN",
        "COMMERCE_PAYMENTS_ORIGIN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
